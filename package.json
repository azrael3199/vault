{
  "name": "vault",
  "private": true,
  "version": "1.0.0",
  "productName": "Vault",
  "appId": "com.vault.app",
  "description": "A local / web service to encrypt, store and view your images",
  "author": "Chinmay Ghungurde",
  "type": "module",
  "main": "electron.js",
  "build": {
    "asar": false,
    "asarUnpack": [
      "node_modules/ps-list/vendor/**",
      "node_modules/.bin/**/*",
      "resources/**/*",
      "server/.env",
      "server/server.exe"
    ],
    "appId": "com.vault.app",
    "files": [
      "public/**/*",
      "dist/**/*",
      "node_modules/**/*",
      "resources/**/*",
      ".env.production",
      ".package.json",
      "src/**/*",
      "electron.js",
      "server/.env",
      "server/server.exe"
    ],
    "directories": {
      "output": "release"
    }
  },
  "scripts": {
    "dev": "vite",
    "start": "concurrently \"vite --host 0.0.0.0\" \"cd server && pnpm start\"",
    "serve": "pnpm build:local && concurrently \"serve -s dist -l tcp://0.0.0.0:3000\" \"cd server && pnpm start\"",
    "build": "vite build --mode production",
    "build:local": "vite build --mode web",
    "prod:network": "pnpm build:local && concurrently \"vite preview --host 0.0.0.0 --port 3000\" \"cd server && pnpm start\"",
    "package": "electron-builder --win --x64",
    "start-electron": "electron .",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "axios": "^1.7.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.7",
    "electron-is-dev": "^3.0.1",
    "lucide-react": "^0.417.0",
    "pnpm": "^9.15.2",
    "ps-list": "^8.1.1",
    "ps-tree": "^1.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.1",
    "react-router-dom": "^6.25.1",
    "react-virtuoso": "^4.18.13",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/ps-tree": "^1.1.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.2.2",
    "vite": "^5.3.4"
  }
}
